# 필수: Builder와 생성된 에이전트가 사용하는 Anthropic API 키
ANTHROPIC_API_KEY=

# 선택: web_search 도구용. 없으면 web_search가 명확한 에러 문자열을 반환한다.
TAVILY_API_KEY=

# 선택: Builder LLM 모델 오버라이드 (기본 claude-sonnet-4-6)
DEEP_BUILDER_MODEL=

# 선택: 평가 심판 모델. 기본값이 Builder와 **다른 모델**(claude-haiku-4-5)이다 —
# 같은 모델이 자기 출력을 채점하면 점수가 후해지므로 기본값으로 분리해 두었다.
# 채점은 생성보다 쉬운 작업이라 판별력은 유지되고 비용은 약 1/3이다.
DEEP_BUILDER_JUDGE_MODEL=

# 선택: LangSmith 트레이싱. TRACING=true 인데 API_KEY가 없으면 실행 전에 막는다
# (조용히 꺼진 채로 도는 것이 가장 나쁘다). 키는 https://smith.langchain.com
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deep-builder
