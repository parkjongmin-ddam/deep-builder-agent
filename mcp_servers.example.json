{
  "_comment": "mcp_servers.json 으로 복사해 사용하세요. 비밀값은 ${ENV_VAR} 참조로만 적습니다.",
  "_comment_stdio": "stdio의 command는 PATH를 탄다. venv 의존성이 필요한 서버라면 'python'이 아니라 .venv 인터프리터 경로를 적으세요.",
  "remote_http": {
    "transport": "streamable_http",
    "url": "https://REPLACE-ME.example.com/mcp",
    "headers": { "Authorization": "Bearer ${REMOTE_MCP_TOKEN}" }
  },
  "echo": {
    "transport": "stdio",
    "command": ".venv/Scripts/python.exe",
    "args": ["-m", "examples.echo_mcp_server"],
    "cwd": "."
  },
  "echo_http": {
    "transport": "streamable_http",
    "url": "http://127.0.0.1:8931/mcp"
  }
}
