# OIDC 인증 설정 템플릿 (Phase 7)
#
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml   # 후 값 채우기
#
# 이 파일이 없으면(또는 [auth]가 비어 있으면) 앱은 데모 모드로 뜬다 —
# 사이드바에서 주체를 직접 고르는 기존 동작 그대로다.
#
# ⚠️ 실제 값은 secrets.toml 에만 넣는다. secrets.toml은 gitignore 대상이고
#    이 example 파일은 git 추적 대상이다 (.env / .env.example 과 같은 규칙).
#
# Okta 쪽 설정 (developer.okta.com 무료/Integrator 계정) — 2026-09-28 실측 순서:
#   1. Applications → Create App Integration → OIDC, Web Application
#   2. Sign-in redirect URI 에 아래 redirect_uri 값을 등록
#   3. Security → API → Authorization Server(default) → Claims 에서
#      groups 클레임 추가 (ID Token / Always / 필터 예: 정규식 agent-.*)
#   4. 같은 화면 Access Policies 에 정책+규칙을 최소 1개 만든다 —
#      없으면 MFA까지 통과하고도 no_matching_policy 로 토큰 발급이 거부된다 (실측)
#   5. Okta 그룹 이름은 iam.json 의 "groups" 키에서 복사해 붙여넣는다
#      (agent-builders 등 — 오타면 로그인 후 deny-by-default 거부)
#   6. 앱 Assignments 에 그룹을 할당한다 — 미할당 그룹은 로그인 자체가
#      access_denied 로 차단된다 (완전 차단이 목적이면 이것이 1차 방어선)

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
# 세션 쿠키 서명용 임의 문자열. 예: python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "CHANGE_ME_RANDOM_HEX"
client_id = "OKTA_CLIENT_ID"
client_secret = "OKTA_CLIENT_SECRET"
# Okta org 도메인으로 교체 (-admin 이 붙은 관리자 콘솔 도메인이 아니라 org 도메인).
# groups 클레임을 쓰려면 커스텀 인가 서버 경로 /oauth2/default 를 포함해야 한다.
server_metadata_url = "https://YOUR_OKTA_DOMAIN/oauth2/default/.well-known/openid-configuration"
# scope에 groups를 넣지 않는다 — Okta default 서버에 groups 커스텀 스코프가
# 없으면 invalid_scope 400이 난다 (실측). 클레임을 Always/Any scope로 설정하면
# 아래 3개 스코프만으로 ID 토큰에 groups가 담긴다.
client_kwargs = { scope = "openid profile email" }
