# OIDC 인증 설정 템플릿 (Phase 7)
#
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml   # 후 값 채우기
#
# 이 파일이 없으면(또는 [auth]가 비어 있으면) 앱은 데모 모드로 뜬다 —
# 사이드바에서 주체를 직접 고르는 기존 동작 그대로다.
#
# ⚠️ 실제 값은 secrets.toml 에만 넣는다. secrets.toml은 gitignore 대상이고
#    이 example 파일은 git 추적 대상이다 (.env / .env.example 과 같은 규칙).
#
# Okta 쪽 설정 (developer.okta.com 무료 계정):
#   1. Applications → Create App Integration → OIDC, Web Application
#   2. Sign-in redirect URI 에 아래 redirect_uri 값을 등록
#   3. Security → API → Authorization Server(default) → Claims 에서
#      groups 클레임 추가 (필터 예: 정규식 agent-.*)
#   4. iam.json 의 "groups" 매핑을 Okta 그룹 이름에 맞춘다

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
# 세션 쿠키 서명용 임의 문자열. 예: python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "CHANGE_ME_RANDOM_HEX"
client_id = "OKTA_CLIENT_ID"
client_secret = "OKTA_CLIENT_SECRET"
# Okta org 도메인으로 교체. 커스텀 인가 서버를 쓰면 /oauth2/default 경로 포함.
server_metadata_url = "https://YOUR_OKTA_DOMAIN/.well-known/openid-configuration"
# groups 클레임을 받으려면 scope에 groups를 포함해야 한다 (Okta 기준).
client_kwargs = { scope = "openid profile email groups" }
