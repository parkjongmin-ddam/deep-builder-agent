.venv/
__pycache__/
*.pyc
.env
.pytest_cache/
specs/
mcp_servers.json

# IAM 감사 로그: 실행 기록이라 커밋하지 않는다 (workspace/ 밖에 두는 이유는 runtime/iam.py 참조)
logs/

# 평가 리포트 자동 저장본: 실행할 때마다 쌓이는 산출물이라 커밋하지 않는다.
# 기준값으로 남길 리포트만 `git add -f eval/results/<파일>`로 골라 추적한다
# (한 번 추적된 파일은 이 규칙과 무관하게 계속 추적된다)
eval/results/

# OIDC 클라이언트 비밀값: .env와 같은 규칙 — example만 추적한다
.streamlit/secrets.toml

# 에이전트 작업공간: 사용자가 넣은 문서는 커밋하지 않는다.
# (안내문과 Phase 9 배포 샘플만 추적 — 샘플은 전부 contoso 가상 데이터다.
#  에이전트가 samples/ 에 쓴 산출물이 커밋되지 않도록 samples는 알려진 파일만 연다)
workspace/*
!workspace/README.md
!workspace/samples/
workspace/samples/*
!workspace/samples/README.md
!workspace/samples/*.csv
!workspace/samples/*.txt
